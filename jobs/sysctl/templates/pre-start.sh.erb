#!/bin/bash

set -ex

<% require 'shellwords'
   prefix = p('sysctl_conf_prefix').to_s
   raise 'sysctl_conf_prefix must be a filename prefix' unless /\A[-0-9A-Za-z_.]+\z/.match(prefix)
%>
# store the custom sysctl in sysctl.d so that they automatically go into effect at boot
printf '%s\n' '# Autogenerated by bosh os-conf-release sysctl. Do not edit.' <%= Shellwords.escape(p('sysctl').join("\n")) %> > /etc/sysctl.d/<%= prefix %>-bosh-os-conf-sysctl.conf

# reapply all sysctls now (including the ones we just stored above)
sysctl --system

#!/bin/bash

set -xeu -o pipefail
<% require 'shellwords' %>

date
printf 'Delaying start for %s seconds\n' <%= Shellwords.escape(p("pre_start_delay").to_s) %>
sleep -- <%= Shellwords.escape(p("pre_start_delay").to_s) %>
date

if ! grep -e '^-e 2$' /etc/audit/rules.d/audit.rules -q; then
  printf '%s\n' '# Custom rules; added by auditd job (os-conf-release)' <%= Shellwords.escape(p('rules').join("\n")) %> >> /etc/audit/rules.d/audit.rules

  echo '
# Make audit rules immutable; added by auditd job (os-conf-release)
-e 2' >> /etc/audit/rules.d/audit.rules

  # If auditd has trouble coming up, (e.g. `ENOBUFS`), we try for 5 minutes
  # before giving up
  COUNT=0
  service auditd stop
  while ! service auditd status && [ $COUNT -lt 10 ]; do
    service auditd restart
    COUNT=$(( COUNT + 1 ))
    sleep 30
  done
  if [ $COUNT -ge 10 ]; then
    echo "Could not start auditd; tried $COUNT times. Check auditd logs"
    exit 1
  fi
fi
